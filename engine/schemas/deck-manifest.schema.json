{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-deck-kit/schemas/deck-manifest.schema.json",
  "title": "AI Deck Kit deck.json manifest",
  "description": "Structured manifest for a .deck bundle, per docs/deck-format-spec.md section 3.",
  "type": "object",
  "required": [
    "schema",
    "title",
    "slug",
    "audience",
    "goal",
    "template",
    "slideTypeCatalog",
    "blockCatalog",
    "contentSchemaVersion",
    "outputMode",
    "status",
    "defaults",
    "slides"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^ai-deck-kit/deck@\\d+\\.\\d+\\.\\d+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "audience": { "type": "string" },
    "goal": { "type": "string" },
    "template": {
      "type": "object",
      "required": ["set", "version"],
      "properties": {
        "set": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      },
      "additionalProperties": false
    },
    "slideTypeCatalog": { "type": "string" },
    "blockCatalog": { "type": "string" },
    "contentSchemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "outputMode": { "type": "string" },
    "status": { "type": "string" },
    "defaults": {
      "type": "object",
      "required": ["animation", "transition"],
      "properties": {
        "animation": { "type": "string" },
        "transition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "file"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["prompt", "document", "outline"] },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
