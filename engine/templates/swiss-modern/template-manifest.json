{
  "name": "swiss-modern",
  "displayName": "Swiss Modern",
  "templateVersion": "1.0.0",
  "contentSchemaVersion": "1.0.0",
  "slideTypeCatalog": "v1",
  "runtime": ["react", "static-html"],
  "iconFamily": "phosphor-react",
  "defaultAnimation": "gentle-rise",
  "designTokens": {
    "color": true,
    "typography": true,
    "spacing": true,
    "grid": true,
    "radii": true,
    "stroke": true,
    "shadow": true
  },
  "supportedSlideTypes": [
    "title",
    "section-divider",
    "closing",
    "agenda",
    "text-statement",
    "text-list",
    "two-column-text",
    "quote",
    "numbered-framework",
    "full-bleed-image",
    "image-text-split",
    "image-grid",
    "icon-grid",
    "diagram",
    "metric-highlight",
    "chart",
    "evidence-stack",
    "case-study",
    "process-flow",
    "before-after",
    "ui-showcase",
    "timeline"
  ],
  "layoutSource": {
    "react": "layouts/react",
    "specs": "layouts/specs"
  },
  "qualityRules": {
    "oneIdeaPerSlide": true,
    "maxAccentColors": 0,
    "cornerRadius": "sharp",
    "iconWeight": "regular",
    "motionLevel": "restrained"
  }
}
