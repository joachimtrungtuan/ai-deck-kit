{
  "name": "clarity-courseware",
  "displayName": "Clarity Courseware",
  "deckClass": "clarity-courseware-deck",
  "templateVersion": "1.0.0",
  "contentSchemaVersion": "1.0.0",
  "slideTypeCatalog": "clarity-courseware-v1",
  "blockCatalog": "v1",
  "runtime": [
    "react",
    "static-html"
  ],
  "iconFamily": "phosphor-react",
  "defaultAnimation": "gentle-rise",
  "supportedSlideTypes": [
    "title",
    "section-divider",
    "content-text",
    "content-media",
    "table",
    "code",
    "data-visual",
    "full-bleed-image",
    "quote",
    "closing"
  ],
  "layoutVariants": {
    "title": ["editorial-left", "orange-statement", "black-hero"],
    "section-divider": ["number-led", "chapter-band"],
    "content-text": ["statement", "rule-list", "two-column", "concept-callout"],
    "content-media": ["split-figure", "captioned-figure", "image-grid"],
    "table": ["reference-table", "comparison-table"],
    "code": ["explain-and-code", "focus-lines"],
    "data-visual": ["metric-highlight", "comparison-chart", "concept-diagram"],
    "full-bleed-image": ["editorial-overlay", "caption-strip"],
    "quote": ["centered-quote", "pull-quote"],
    "closing": ["next-steps", "final-statement"]
  },
  "backgroundVariants": ["white", "orange", "black"],
  "designTokens": {
    "color": true,
    "typography": true,
    "spacing": true,
    "grid": true,
    "radii": true,
    "stroke": true,
    "shadow": true
  },
  "layoutSource": {
    "react": "layouts/react",
    "specs": "layouts/specs"
  },
  "primitiveComposition": ["title-description", "image", "chart", "table", "code", "quote", "stat"],
  "qualityRules": {
    "oneIdeaPerSlide": true,
    "maxAccentColors": 1,
    "cornerRadius": "sharp",
    "iconWeight": "light-or-regular",
    "motionLevel": "restrained",
    "defaultBackground": "white"
  }
}
