{
  "name": "ai-deck-kit",
  "version": "0.2.1",
  "type": "module",
  "bin": {
    "aideck": "cli/index.mjs"
  },
  "files": [
    "cli",
    "distribution.json",
    "engine.version.json",
    "primitives",
    "preview-app",
    "schemas",
    "skills",
    "templates",
    "README.md",
    "tsconfig.json",
    "tsconfig.cli-build.json",
    "tsconfig.storybook.json",
    "vite.config.ts",
    "vite.export.config.ts"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "aideck": "node cli/index.mjs",
    "build": "tsc --project tsconfig.cli-build.json",
    "build:watch": "tsc --watch --preserveWatchOutput --project tsconfig.cli-build.json",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck:storybook": "tsc --noEmit --project tsconfig.storybook.json",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "storybook": "^10.5.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
