# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
*node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml
# Engine lockfile is intentionally tracked: consumer installs must be deterministic.
!/engine/package-lock.json

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# Generated runtime layout for release/install smoke tests
/.claude/
# But track repo-level rules that Claude Code reads
!/.claude/rules/

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**
# Exception: the shipped showcase deck's assets are canonical (see plans/
# 260901-1104 phase 3 — nothing under a .deck bundle's assets/ is ignored).
!engine/examples/showcase.deck/assets/
!engine/examples/showcase.deck/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# AI agents
.agents
.opencode
.codex
.agentkit

# Transient browser-automation output
playwright-output/
.playwright-mcp/

# AI Deck Kit — user data (never touched by engine upgrade).
# Keep user decks private by default. Add a specific re-include here only for
# a deliberately chosen repository-owned sample deck.
/decks/*
/templates/
**/.build/
engine/storybook-static/

# The distribution entrypoint is intentionally tracked.
!/bin/
!/bin/create-ai-deck-kit

# The CLI's compiled output is what users actually run: Node cannot strip types
# under node_modules, so the build has to be committed rather than produced at
# install time. Tracked despite the blanket dist/ rule above.
!/engine/cli/dist/
!/engine/cli/dist/**

# Scratch copies of external templates used for compatibility checks; never part of the engine.
tmp-compat-check/
