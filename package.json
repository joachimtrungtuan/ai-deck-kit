{
  "name": "ai-deck-kit",
  "version": "1.1.1",
  "description": "Portable, agent-native presentation toolkit",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/joachimtrungtuan/ai-deck-kit.git" },
  "bin": {
    "ai-deck-kit": "bin/create-ai-deck-kit",
    "aideck": "engine/cli/resolver.mjs"
  },
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "build": "npm --prefix engine run build",
    "build:watch": "npm --prefix engine run build:watch",
    "build:check": "node scripts/check-cli-build-is-current.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "npm --prefix engine run typecheck",
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-strip-types --test engine/cli/tests/*.test.ts",
    "test:serve": "node --experimental-strip-types --test engine/cli/tests/serve.test.ts",
    "test:diagram": "node --experimental-strip-types --test engine/cli/tests/diagram-ir.test.ts",
    "test:lifecycle": "node --experimental-strip-types --test engine/cli/tests/deck-lifecycle.test.ts",
    "test:boundary": "node --experimental-strip-types --test engine/cli/tests/workspace-boundary.test.ts",
    "test:smoke": "node scripts/ci-smoke.mjs"
  }
}
